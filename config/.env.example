# Modelo de configuracao local. Copie para config/.env e preencha.
# O config/.env NUNCA vai para o Git (esta no .gitignore).
# Em producao estes valores vem do ConfigMap e do Secret do Kubernetes.

FOLIO_BASE_URL=https://folio-snapshot-okapi.dev.folio.org
FOLIO_TENANT=diku
FOLIO_USERNAME=diku_admin
FOLIO_PASSWORD=admin
FOLIO_TIMEOUT=60

DIR_SAIDA=./dados

LIMITE_RESPOSTA_SEG=2.0
META_DISPONIBILIDADE=99.5
